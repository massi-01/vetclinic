# Porta del server HTTP
PORT=5000

# Ambiente di esecuzione (development | production | test)
NODE_ENV=development

# Stringa di connessione a MongoDB (Obbligatoria in production)
# Esempio locale: mongodb://localhost:27017/vetclinic
# Esempio cloud: mongodb+srv://<user>:<password>@cluster.mongodb.net/vetclinic?retryWrites=true&w=majority
MONGODB_URI=

# Chiave segreta per la firma dei token JWT (Obbligatoria e complessa in production)
JWT_SECRET=vetclinic_jwt_super_secret_key_2026_dev

# URL del Frontend per policy CORS (separati da virgola in caso di più origini)
# In dev include automaticamente localhost:3000 e localhost:5173
CLIENT_URL=http://localhost:3000

# Flag facoltative
# Abilita Swagger UI in produzione (di default abilitato solo in development)
ENABLE_SWAGGER=false

# Consente l'inserimento di dati demo anche se NODE_ENV=production (usare solo per test)
ALLOW_SEED=false
